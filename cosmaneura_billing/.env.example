# Copy to .env for local Compose use. Never commit .env or real credentials.
COSMANEURA_BIND=127.0.0.1
COSMANEURA_PORT=8000
COSMANEURA_IMAGE=cosmaneura-billing:local
COSMANEURA_ENV=production
COSMANEURA_LOG_LEVEL=INFO
COSMANEURA_MIGRATIONS_DIR=

# API-only explicit numeric LLM metrics. Azure deploys these through the API
# UAMI; the same identity is the only principal authorized for Azure OpenAI.
# Local Compose leaves telemetry and live inference disabled. Never enable
# generic Azure/OTel HTTP, SQL, exception, trace, profiler, or logging
# auto-instrumentation.
COSMANEURA_TELEMETRY_ENABLED=false
APPLICATIONINSIGHTS_CONNECTION_STRING=
AZURE_CLIENT_ID=

# Production trusts this header mode only behind Azure Container Apps built-in
# authentication. This Compose topology is a packaging smoke stack, so its
# protected routes intentionally return 401 without that trusted Azure layer.
COSMANEURA_AUTH_MODE=container_apps
COSMANEURA_ENTRA_TENANT_ID=
COSMANEURA_ALLOWED_ROLES=Admin,BillingStaff,Coder,Provider
COSMANEURA_CORS_ORIGINS=
COSMANEURA_MAX_REQUEST_BYTES=1048576
COSMANEURA_INFERENCE_REQUESTS_PER_MINUTE=10
COSMANEURA_GENERAL_REQUESTS_PER_MINUTE=60
COSMANEURA_AUTH_FAILURES_PER_MINUTE=30
COSMANEURA_STATE_STORE=postgres
# Required shared random secret, 32-256 ASCII characters; never commit a value.
COSMANEURA_REVIEW_CONTEXT_SIGNING_KEY=

# Required local-pilot identity and database settings.
COSMANEURA_PRACTICE_ID=synthetic-pilot
COSMANEURA_PRACTICE_NAME=Your Care Team
COSMANEURA_UPLOAD_URL=https://example.invalid/insurance
COSMANEURA_CHASE_APPROVAL=per_policy
POSTGRES_DB=cosmaneura
POSTGRES_USER=cosmaneura
POSTGRES_PASSWORD=
# RFC 3986 percent-encoding of the same raw password for the owner DSN.
POSTGRES_URL_PASSWORD=
POSTGRES_APP_USER=cosmaneura_app
POSTGRES_APP_PASSWORD=
# RFC 3986 percent-encoding of the same raw runtime password for the app DSN.
POSTGRES_APP_URL_PASSWORD=
COSMANEURA_DB_RUNTIME_ROLE=cosmaneura_app
COSMANEURA_BOOTSTRAP_ADMIN_OID=

# Dedicated scheduled-worker database principal. The migration job uses the
# role/password to provision it. COSMANEURA_CHASE_WORKER_DATABASE_URL is for the
# one-shot worker job only; never inject it into the API container. The local
# Compose smoke topology does not run the worker.
COSMANEURA_CHASE_WORKER_DB_ROLE=cosmaneura_chase_worker
COSMANEURA_CHASE_WORKER_DB_PASSWORD=
COSMANEURA_CHASE_WORKER_DATABASE_URL=

# Dedicated source-import database principal and no-ingress Athena sync job.
# Keep disabled/mock unless the separately reviewed live contract is complete.
# The import password is migration-job-only; the import DSN is sync-job-only.
COSMANEURA_ATHENA_IMPORT_DB_ROLE=cosmaneura_athena_import
COSMANEURA_ATHENA_IMPORT_DB_PASSWORD=
COSMANEURA_ATHENA_IMPORT_DATABASE_URL=
COSMANEURA_ATHENA_SYNC_ENABLED=false
COSMANEURA_ATHENA_MODE=disabled
COSMANEURA_ATHENA_BASE_URL=
COSMANEURA_ATHENA_TOKEN_URL=
COSMANEURA_ATHENA_CLIENT_ID=
COSMANEURA_ATHENA_SCOPES=
COSMANEURA_ATHENA_CLIENT_SECRET=

# Durable chase scheduler. These fail-closed defaults never contact a patient,
# but record_only may still create a manual phone task for staff. A deployed
# scheduler requires a secret gate key of at least 32 bytes, even record_only.
COSMANEURA_CHASE_SCHEDULER_ENABLED=false
COSMANEURA_CHASE_TRANSPORT=record_only
COSMANEURA_CHASE_GATE_HMAC_KEY=
COSMANEURA_PRACTICE_TIMEZONE=UTC
COSMANEURA_CONTACT_SNAPSHOT_MAX_AGE_HOURS=24
COSMANEURA_CHASE_WORKER_BATCH_SIZE=25
COSMANEURA_CHASE_WORKER_LEASE_SECONDS=300

# ACS policy metadata is shared verbatim by the API and worker so both compute
# the same approval fingerprint. The connection string is worker-job-only and
# must never be configured on a deployed API. Leave both latches false and all
# ACS values empty until the deployment layer, BAA, P5 redaction, and acceptance
# checks are complete. SMS and outbound voice are not implemented.
COSMANEURA_PATIENT_MESSAGING_ENABLED=false
COSMANEURA_PATIENT_MESSAGING_OPERATIONALLY_ACTIVATED=false
COSMANEURA_ACS_EMAIL_ENDPOINT=
COSMANEURA_ACS_EMAIL_SENDER_ADDRESS=
COSMANEURA_ACS_EMAIL_REPLY_TO_ADDRESS=
COSMANEURA_ACS_EMAIL_CONNECTION_STRING=

# Used by scripts outside Compose. Compose constructs DATABASE_URL internally.
DATABASE_URL=

# Live extraction is explicit, managed-identity-only, and disabled by default.
# The deployed API receives no model API key or static bearer token. Do not set
# OPENAI_API_KEY, AZURE_OPENAI_API_KEY, or AZURE_OPENAI_AD_TOKEN in staging or
# production. Strict-schema and JSON-object fallback acceptance is still
# synthetic/de-identified only; real PHI additionally requires documented
# Microsoft Azure OpenAI service/data-zone agreement and configuration review.
COSMANEURA_AZURE_OPENAI_ENABLED=false
# Public synthetic demos must set this second latch to true. Model-backed
# routes then accept only stored rows carrying the reserved, server-owned
# synthetic_demo_release_candidate provenance; ad-hoc payloads fail closed.
COSMANEURA_AZURE_OPENAI_SYNTHETIC_ONLY=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-5-6-sol-2026-07-09
AZURE_OPENAI_MODEL=gpt-5.6-sol
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional second extraction engine. Provisioning does not enable it.
COSMANEURA_AZURE_LANGUAGE_ENABLED=false
# Observation-only lane. Mutually exclusive with the active-consensus flag
# above and valid only when primary Azure OpenAI inference is enabled.
COSMANEURA_AZURE_LANGUAGE_SHADOW_ENABLED=false
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_API_VERSION=2023-04-01
COSMANEURA_AZURE_LANGUAGE_MOCK=false

# Optional external regulatory data paths inside the app container.
ICD10_CCSR_CSV=
CPT_DATA_DIR=
CPT_AUTO_FETCH=1

# Optional AMA CPT API configuration. These four values are all-or-none.
AMA_TOKEN_URL=
AMA_BASE_URL=
AMA_CONSUMER_KEY=
AMA_CONSUMER_SECRET=
AMA_RELEASES_PATH=/cpt-zip/1.0.0/releases
AMA_FILE_PATH=/cpt-zip/1.0.0/files?release={release}

# Adaptive-review defaults. Reviewer identity comes only from the Entra session.
COSMANEURA_PREF_MIN=3
COSMANEURA_PREF_GLOBAL_USERS=3
COSMANEURA_PREFS=1
COSMANEURA_DIRECT_CONTRACT_LIST=/var/lib/cosmaneura/direct_contract_patients.csv

# Local development/test only. Staging and production reject these file seams.
COSMANEURA_FEEDBACK_PATH=coder_feedback.jsonl
COSMANEURA_ACCESS_AUDIT_PATH=access_audit.jsonl

# Optional for a local, already-built frontend. The image sets /app/static.
COSMANEURA_FRONTEND_DIST=
